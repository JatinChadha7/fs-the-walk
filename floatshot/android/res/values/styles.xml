<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FloatShot" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>

    <style name="Theme.FloatShot.Editor" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorAccent">@color/editor_accent</item>
        <item name="android:colorPrimary">@color/editor_accent</item>
        <item name="android:windowBackground">@color/editor_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.FloatShot.Transparent" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Setup screen -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="CardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Bullet" parent="CardBody">
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:drawableStart">@drawable/bullet</item>
        <item name="android:drawablePadding">12dp</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="FilledButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/btn_filled</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/btn_filled_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="OutlinedButton" parent="FilledButton">
        <item name="android:background">@drawable/btn_outlined</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="LinkButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PickerLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PickerRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Editor -->
    <style name="EditorIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/editor_icon_tint</item>
    </style>

    <style name="AccentPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:background">@drawable/pill_accent</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/editor_on_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/editor_on_accent</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="EditorTextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/pill_ghost</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/editor_icon</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
