<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jc.floatshot">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35" />

    <!-- The floating button is an overlay window. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The button lives in a foreground service; screen capture must run inside one too. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No INTERNET permission: screenshots never leave the phone unless the user shares them. -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.FloatShot"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible screen that shows Android's "start screen capture?" prompt. -->
        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.FloatShot.Transparent"
            android:taskAffinity="com.jc.floatshot.capture"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <!-- Each screenshot opens in its own task so closing it returns to the app it came from. -->
        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:label="@string/editor_label"
            android:theme="@style/Theme.FloatShot.Editor"
            android:taskAffinity="com.jc.floatshot.editor"
            android:autoRemoveFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode" />

        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating screenshot button that stays on screen until the user turns it off" />
        </service>

        <provider
            android:name=".ShareProvider"
            android:authorities="com.jc.floatshot.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
